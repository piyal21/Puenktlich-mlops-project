# Copy to .env (git-ignored): `make setup` does it for you. Placeholders only — never commit real values.

APP_ENV=local
LOG_LEVEL=INFO
AWS_REGION=eu-central-1

# --- Local object storage (MinIO). Also used as MinIO root user/password by docker-compose. ---
# URLs below are for code running on your machine; containers use http://minio:9000 and
# http://mlflow:5000 (set in docker-compose.yml).
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY_ID=puenktlich
STORAGE_SECRET_ACCESS_KEY=change-me-minio-password
DATA_BUCKET=puenktlich-local
MODELS_BUCKET=puenktlich-local
WEB_BUCKET=puenktlich-local
MODEL_POINTER_PARAM=.local/champion_version

# --- Postgres (MLflow backend store). Password goes into a URL: use URL-safe chars only (A-Z a-z 0-9 - _). ---
POSTGRES_USER=puenktlich
POSTGRES_PASSWORD=change-me-postgres-password

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- DB Timetables API (from https://developers.deutschebahn.com/db-api-marketplace) ---
DB_API_CLIENT_ID=
DB_API_KEY=
